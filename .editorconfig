root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj,props,targets,sln}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.sql]
indent_size = 4

# C# analyzers. The build treats warnings as errors, so every rule left at warning level is a gate.
# CA2007 (ConfigureAwait) stays off: ASP.NET Core has no synchronisation context.
[*.cs]
dotnet_diagnostic.CA2007.severity = none

# Test projects name scenarios with underscores and are never called by external code.
[**/tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
