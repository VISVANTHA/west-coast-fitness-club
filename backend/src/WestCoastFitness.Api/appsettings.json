{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "west-coast-fitness",
    "Audience": "west-coast-fitness-members",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "AuthPermitLimit": 10,
    "WindowSeconds": 60
  }
}
