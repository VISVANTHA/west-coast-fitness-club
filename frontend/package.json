{
  "name": "west-coast-fitness-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "React client for the West Coast Fitness Club API (Webpack build).",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.14.0",
    "npm": "10.9.2"
  },
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "tsc --build && webpack --mode production",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "duplication": "jscpd src"
  },
  "dependencies": {
    "lodash": "4.17.20",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/lodash": "4.17.20",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "3.2.7",
    "css-loader": "7.1.5",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "html-webpack-plugin": "5.6.8",
    "jscpd": "4.0.5",
    "jsdom": "26.1.0",
    "mini-css-extract-plugin": "2.10.2",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "3.2.7",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "5.2.3"
  },
  "overrides": {
    "vite": "6.4.3"
  }
}
